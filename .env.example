# Me Guild F — public frontend only; never put backend secrets here.
# Copy this file to .env. Existing .env.local values take priority over .env.
# Local: use localhost consistently. This machine reserves 3002 for AG.
NEXTAUTH_URL=http://localhost:3000
ME_GUILD_OFFICE_URL=http://localhost:3004

# Public URL, embedded into the browser bundle at build time.
NEXT_PUBLIC_ME_COIN_PORTAL_ORIGIN=https://me-coins.me-prompt-technology.com

# On B: ME_GUILD_FRONTEND_URL must match F's NEXTAUTH_URL.
# B's NEXTAUTH_URL is its Office origin, e.g. http://localhost:3004.
# Google/Discord client IDs, secrets, database and session keys belong only in B.
# Production: replace both URLs above with explicit HTTPS origins.
