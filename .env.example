# Me Guild F — จัดกลุ่ม environment ตามหน้าที่และช่วงเวลาที่ใช้งาน
# ไฟล์ตัวอย่างที่นำขึ้น Git ต้องมีเฉพาะค่าตัวอย่าง ไม่ใส่รหัสผ่านหรือ secrets จริง
# Local setup: ../me-guild-bot/docs/local-marketplace-setup.md

# -----------------------------------------------------------------------------
# 1. Frontend F — การเชื่อมต่อฝั่ง server (runtime)
# -----------------------------------------------------------------------------
# Production: กำหนด URL ทั้งสองให้ชัดเจน; frontend และ Office ต้องเป็น HTTPS
# ME_GUILD_OFFICE_URL ใช้ทั้ง API ของ B และลิงก์ Office; F และ browser ต้องติดต่อได้
# ME_GUILD_FRONTEND_URL ต้องตรงกับค่าบน B และ bot รวมถึง OAuth callback
# Local: ใช้ localhost หรือ 127.0.0.1 ให้ตรงกันทุกบริการ
ME_GUILD_FRONTEND_URL=
ME_GUILD_OFFICE_URL=

# -----------------------------------------------------------------------------
# 2. Frontend F — URL สาธารณะของ ME Coin (build time)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_* ถูกฝังใน browser bundle ตอน build; ใช้เฉพาะค่าที่เผยแพร่ได้
# หากเปลี่ยน URL นี้ ต้องส่งค่าให้ขั้นตอน build และ build image ใหม่
NEXT_PUBLIC_ME_COIN_PORTAL_ORIGIN=https://me-coins.me-prompt-technology.com

# -----------------------------------------------------------------------------
# 3. Backend เดิม — URL และการเชื่อมต่อ bot
# -----------------------------------------------------------------------------
# ตั้งแต่แยก frontend แล้ว F ไม่อ่านตัวแปรกลุ่ม 3–9 ด้านล่าง
# ค่าในกลุ่มเหล่านี้เป็นของ backend/ระบบเดิม ไม่ใช่ค่าที่ต้องเพิ่มเพื่อ deploy F
ME_GUILD_BOT_API_URL="https://me-guild-bot.me-prompt-technology.com"
COMMUNITY_MEMBER_SECRET=""

# -----------------------------------------------------------------------------
# 4. Backend เดิม — ฐานข้อมูล
# -----------------------------------------------------------------------------
# F ไม่มี Prisma และไม่เชื่อมต่อฐานข้อมูลโดยตรง
DATABASE_URL=

# -----------------------------------------------------------------------------
# 5. Backend เดิม — Discord OAuth
# -----------------------------------------------------------------------------
# F ส่งคำขอ login ผ่าน B; client secret จัดการที่ B
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# 6. Backend เดิม — Google OAuth
# -----------------------------------------------------------------------------
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET ใช้ที่ B
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# 7. Backend เดิม — NextAuth / session
# -----------------------------------------------------------------------------
# NEXTAUTH_URL เป็น URL ของ NextAuth ฝั่ง backend เดิม; F ใช้ ME_GUILD_FRONTEND_URL
# F ไม่ใช้ NEXTAUTH_SECRET
NEXTAUTH_URL="https://me-guild.me-prompt-technology.com"
NEXTAUTH_SECRET=

# -----------------------------------------------------------------------------
# 8. Backend เดิม — อีเมล SMTP
# -----------------------------------------------------------------------------
# F ไม่มีบริการส่งอีเมลโดยตรง
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_REQUIRE_TLS="true"
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# -----------------------------------------------------------------------------
# 9. Deployment เดิม — migration
# -----------------------------------------------------------------------------
# ไม่ใช้กับ deployment ของ F ปัจจุบัน: Dockerfile ไม่มี target migrator
# ในระบบ deploy ของ F ให้เว้น migration target และ migration env keys ว่าง
ME_RESOURCE_MIGRATION_TARGET="migrator"
ME_RESOURCE_MIGRATION_ENV_KEYS="DATABASE_URL"
