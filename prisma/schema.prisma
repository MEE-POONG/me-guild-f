  @@index([permission, granted])
  @@map("me_guild_office_staff_permissions")
}

model OfficeStaffUser {
  id                 String                  @id @default(auto()) @map("_id") @db.ObjectId
  email              String                  @unique
  providerEmail      String?
  passwordHash       String?
  googleId           String?
  discordId          String?
  name               String?
  phone              String?
  employeeCode       String?
  jobTitle           String? // Legacy display snapshot; new assignments use positionId.
  avatarUrl          String?
  role               OfficeRole              @default(STAFF)
  departmentId       String?                 @db.ObjectId
  department         OfficeDepartment?       @relation(fields: [departmentId], references: [id])
  positionId         String?                 @db.ObjectId
  position           OfficePosition?         @relation(fields: [positionId], references: [id])
  isActive           Boolean                 @default(true)
  approvalStatus     OfficeApprovalStatus    @default(APPROVED)
  emailVerifiedAt    DateTime?
  approvedAt         DateTime?
  approvedBy         String?
  rejectionReason    String?
  profileCompletedAt DateTime?
  authVersion        Int                     @default(1)
  lastLoginAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  permissions        OfficeStaffPermission[]
  authChallenges     OfficeAuthChallenge[]
  auditActions       OfficeAuditLog[]        @relation("OfficeAuditActor")

  @@index([departmentId, isActive])
  @@index([positionId, isActive])
  // Nullable identity fields use partial unique MongoDB indexes from the auth index setup script.
  @@index([googleId])
  @@index([discordId])
  @@index([employeeCode])
  @@map("me_guild_office_staff")
}

