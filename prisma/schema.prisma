// ข้อมูลเซิร์ฟเวอร์ - เก็บการตั้งค่าเซิร์ฟเวอร์ Discord
model ServerDB {
  guildHeadquartersLimit      Int     @default(1) // จำนวนที่ทำการหลักที่รับได้
  guildHeadquartersLeaseToken String?
  guildHeadquartersLeaseUntil DateTime?
