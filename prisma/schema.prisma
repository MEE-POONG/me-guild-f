generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model ActDetailDB {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String // ชื่อกิจกรรม
  description String // รายละเอียดกิจกรรม
  dislink     String // ลิงก์ Discord
  disname     String // ชื่อใน Discord
  img         String // รูปภาพกิจกรรม
  type        String // ประเภทกิจกรรม
  point       String // คะแนนที่ได้รับ
  startdate   String // วันที่เริ่มต้น
  enddate     String // วันที่สิ้นสุด
  createdAt   DateTime @db.Date
  createdBy   String
  updatedAt   DateTime @db.Date
  updatedBy   String
  deleteBy    String
  actType     ActType? @relation(fields: [actTypeId], references: [id]) // ความสัมพันธ์กับประเภทกิจกรรม
  actTypeId   String   @db.ObjectId
}

// ประเภทกิจกรรม - จัดหมวดหมู่กิจกรรม
model ActType {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  name        String // ชื่อประเภทกิจกรรม
  createdAt   DateTime      @db.Date
  createdBy   String
  updatedAt   DateTime      @db.Date
  updatedBy   String
  deleteBy    String
  ActDetailDB ActDetailDB[] // กิจกรรมทั้งหมดในประเภทนี้
}

// ========================================
// 📝 Blog & Content (บล็อกและคอนเทนต์)
// ========================================

// บล็อก - เก็บบทความและเนื้อหา
model BlogDB {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String // หัวข้อบล็อก
  creditlink  String // ลิงก์อ้างอิง/เครดิต
  description String // เนื้อหาบล็อก
  img         String // รูปภาพประกอบ
  video       String // วิดีโอประกอบ
  createdAt   DateTime @db.Date
  createdBy   String
  updatedAt   DateTime @db.Date
  updatedBy   String
  deleteBy    String
}

// ========================================
// ⏱️ User Activity Tracking (ติดตามกิจกรรมผู้ใช้)
// ========================================

// ระบบเช็คออนไลน์ - บันทึกเวลาออนไลน์ของผู้ใช้
model CheckOnlineDB {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  discord_id      String? // Discord ID ของผู้ใช้
  checkIn         DateTime  @default(now()) // เวลาที่เข้าระบบ
  checkOut        DateTime? // เวลาที่ออกจากระบบ
  totalOnlineTime Int       @default(0) // ระยะเวลาออนไลน์ทั้งหมด (วินาที)
  createdAt       DateTime  @default(now())
  createdBy       String?
  updatedAt       DateTime  @updatedAt
  updatedBy       String
  deleteBy        String
}

// ความคิดเห็น - เก็บคอมเมนต์จากผู้ใช้
model CommentDB {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String // ชื่อผู้แสดงความคิดเห็น
  userID    String // ID ของผู้ใช้
  content   String // เนื้อหาความคิดเห็น
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  deleteBy  String?
}

// โค้ดแพ็คเกจ - เก็บโค้ดสำหรับเติมวันใช้งาน
model PackageCodeDB {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  code       String    @unique // รหัสโค้ด
  days       Int // จำนวนวันที่ได้รับ
  isUsed     Boolean   @default(false) // ถูกใช้ไปหรือยัง
  discord_id String?   @map("usedBy") // Discord Guild ID ที่ใช้โค้ด (เก็บในฟิลด์เดิมเพื่อรักษาข้อมูล)
  server     ServerDB? @relation(fields: [discord_id], references: [serverId])
  usedAt     DateTime? // เวลาที่ใช้
  createdAt  DateTime  @default(now())
  createdBy  String?

  @@index([discord_id])
}

// ========================================
// 👥 Customer Management (ลูกค้า)
// ========================================

// ข้อมูลลูกค้า - เก็บข้อมูลลูกค้าที่ลงทะเบียน
model CustomerDB {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  discord_id String   @unique // Discord ID (ไม่ซ้ำกัน)
  username   String // ชื่อผู้ใช้
  email      String   @unique // อีเมล (ไม่ซ้ำกัน)
  password   String // รหัสผ่าน
  server     String   @unique // เซิร์ฟเวอร์ (ไม่ซ้ำกัน)
  createdAt  DateTime @db.Date
  createdBy  String
  updatedAt  DateTime @db.Date
  updatedBy  String
  deleteBy   String
}

// ========================================
// 🎮 Game Management (จัดการเกม)
// ========================================

type StoredDecorationImage {
  id              String
  url             String
  key             String?
  filename        String
  mimeType        String
  size            Int
  storageProvider String
  uploadedAt      DateTime
}

// เกมออนไลน์ - เก็บข้อมูลเกมที่รองรับในระบบ
model GameOnlineDB {
  id                   String                 @id @default(auto()) @map("_id") @db.ObjectId
  game_name            String // ชื่อเกมเดิมสำหรับระบบที่ยังอ่านฟิลด์นี้
  nameTh               String? // ชื่อเกมภาษาไทย
  nameEn               String? // ชื่อเกมภาษาอังกฤษ
  shortName            String? // คำย่อชื่อเกม
  logo                 String? // URL โลโก้เกมล่าสุดจาก me-db
  logoFile             StoredDecorationImage? // metadata ไฟล์โลโก้ล่าสุดจาก me-db
  banner               String? // URL ภาพแบนเนอร์แนวนอนสำหรับแสดงในส่วนอื่น
  bannerFile           StoredDecorationImage? // metadata ไฟล์แบนเนอร์ล่าสุดจาก me-db
  numberMatch          String? // จำนวนแมทช์
  partyLimit           Int // จำนวนผู้เล่นสูงสุดต่อปาร์ตี้
  ranking              Boolean // มีระบบแรงค์หรือไม่
  popularityRank       Int? // อันดับความนิยมล่าสุด (เลขน้อยนิยมมากกว่า)
  popularityAsOf       DateTime?              @db.Date // วันที่อ้างอิงอันดับความนิยม
  categoryIds          String[]               @default([]) @db.ObjectId // Categories/แท็กที่ติดกับเกมโดยตรง
  createdAt            DateTime               @db.Date
  createdBy            String?
  updatedAt            DateTime               @db.Date
  updatedBy            String
  deleteBy             String
  // ความสัมพันธ์ many-to-many ผ่าน GameTypeGame
  gameTypeGame         GameTypeGame[]         @relation("GameOnlineToGameTypeGame")
  GameRankDB           GameRankDB[] // แรงค์ของเกม
  GameConditionMatchDB GameConditionMatchDB[] // เงื่อนไขการจับคู่
}

// เงื่อนไขการจับคู่เกม - กำหนดเงื่อนไขสำหรับการจับคู่ผู้เล่น
model GameConditionMatchDB {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  maxParty     Int // จำนวนปาร์ตี้สูงสุด
  limitNumber  Int           @default(0) // จำนวนผู้เล่นจำกัด
  gameOnlineDB GameOnlineDB? @relation(fields: [gameId], references: [id])
  gameId       String        @db.ObjectId
  createdAt    DateTime      @default(now())
  createdBy    String?
  updatedAt    DateTime      @updatedAt
  updatedBy    String
  deleteBy     String
}

// หมวดหมู่เกม - จัดหมวดหมู่เกม
model GameCategoryDB {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String   @unique // ชื่อหมวดหมู่ (ไม่ซ้ำกัน)
  titleEn   String?  // ชื่อหมวดหมู่ภาษาอังกฤษ รองรับข้อมูลเดิมที่ยังไม่มีค่า
  detail    String?  // คำอธิบายขยายความสำหรับใช้เป็นแท็กเกม
  createdAt DateTime @db.Date
  createdBy String
  updatedAt DateTime @db.Date
  updatedBy String
  deleteBy  String
}

// การจับคู่เกม - เก็บข้อมูลการจับคู่ผู้เล่น
model GameMatchDB {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String // ID ผู้ใช้ที่สร้างแมทช์
  gameId       String   @db.ObjectId // ID เกม
  rank         Boolean // เป็นแมทช์แรงค์หรือไม่
  selectRankID String?  @db.ObjectId // แรงค์ที่เลือก
  channel_id   String // ID ช่อง Discord
  partyLimit   Int // จำนวนผู้เล่นสูงสุด
  limitNumber  Int // จำนวนจำกัด
  status       Boolean // สถานะแมทช์ (เปิด/ปิด)
  members      String[] // รายชื่อสมาชิกในแมทช์
  createdAt    DateTime @default(now())
  createdBy    String?
  updatedAt    DateTime @updatedAt
  updatedBy    String
  deleteBy     String
}

// ประเภทเกม - ประเภทย่อยของเกม (เช่น MOBA, FPS, RPG)
model GameTypeDB {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  title        String // ชื่อประเภทเกม
  categoryId   String         @db.ObjectId // หมวดหมู่ของประเภทเกม
  createdAt    DateTime       @db.Date
  createdBy    String
  updatedAt    DateTime       @db.Date
  updatedBy    String
  deleteBy     String
  // ความสัมพันธ์ many-to-many ผ่าน GameTypeGame
  gameTypeGame GameTypeGame[] @relation("GameTypeToGameTypeGame")
  titleTh       String? // ชื่อภาษาไทย
  titleEn       String? // ชื่อภาษาอังกฤษ
  descriptionTh String? // คำอธิบายภาษาไทย
  descriptionEn String? // คำอธิบายภาษาอังกฤษ
  logoUrl       String? // URL โลโก้ล่าสุดจาก me-db
  logoFile      StoredDecorationImage? // metadata ไฟล์โลโก้ล่าสุดจาก me-db
}

// ตารางเชื่อมโยง - เชื่อมโยงเกมกับประเภทเกม (Many-to-Many)
model GameTypeGame {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @db.Date
  createdBy String
  updatedAt DateTime @db.Date
  updatedBy String
  deleteBy  String

  // ความสัมพันธ์กับ GameOnlineDB
  gameId       String?       @db.ObjectId
  gameOnlineDB GameOnlineDB? @relation(fields: [gameId], references: [id], onDelete: Cascade, name: "GameOnlineToGameTypeGame")

  // ความสัมพันธ์กับ GameTypeDB
  typeId     String?     @db.ObjectId
  gameTypeDB GameTypeDB? @relation(fields: [typeId], references: [id], onDelete: Cascade, name: "GameTypeToGameTypeGame")
}

// แรงค์ของเกม - เก็บข้อมูลระดับแรงค์ในเกม
model GameRankDB {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  gameOnlineDB GameOnlineDB? @relation(fields: [gameId], references: [id])
  gameId       String?       @db.ObjectId
  imgRank      String // รูปภาพแรงค์
  imgRankFile  StoredDecorationImage? // metadata ไฟล์รูปแรงค์ล่าสุดจาก me-db
  selcetShow   String? // แสดงในการเลือกหรือไม่
  nameRank     String // ชื่อแรงค์ (เช่น Bronze, Silver, Gold)
  number       Int // ลำดับแรงค์
  createdAt    DateTime      @db.Date
  createdBy    String
  updatedAt    DateTime      @db.Date
  updatedBy    String
  deleteBy     String
}

// ========================================
// 🏰 Guild System (ระบบกิลด์)
// ========================================

// ข้อมูลกิลด์ - เก็บข้อมูลกิลด์หลัก
// Durable provenance for the shared Discord council role.
model CouncilMembershipState {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  serverId           String
  userId             String
  roleId             String?
  founderGuildIds    String[] @default([])
  qualifyingRoleIds  String[] @default([])
  independentGranted Boolean  @default(false)
  independentSource  String? // PRE_EXISTING | MANUAL
  reason             String?
  grantedBy          String?
  grantedAt          DateTime?
  desired            Boolean  @default(false)
  syncPending        Boolean  @default(true)
  lastError          String?
  lastSyncedAt       DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([serverId, userId])
  @@index([syncPending, updatedAt])
}

model GuildDB {
  registrationServerId   String? // Discord ต้นทางที่ลงทะเบียน (ไม่เปลี่ยนเมื่อย้าย)
  registrationServerName String?
  headquartersMove       Json? // durable prepare/retire/activate journal for one headquarters
  headquartersTargetServerId String? // quota reservation while moving
  governanceVersion        Int? // Optimistic lock for reviewed founder roster changes
  founderHistory           Json? // Bounded audit history; founding signatures remain immutable
  serverId                 String?
  purpose                  String?
  description              String?
  organizationType         String? // COMMUNITY | GAMING | CREATIVE | OTHER
  foundingReportId         String? @db.ObjectId
  foundedAt                DateTime?
  minimumFounders           Int?

  id                       String         @id @default(auto()) @map("_id") @db.ObjectId
  Logo                     String         @default("https://www.design365print.com/UploadFile/Blog/blog_941976621.jpg") // โลโก้กิลด์
  guild_leader             String? // หัวหน้ากิลด์
  guild_level              Int? // เลเวลกิลด์
  guild_name               String? // ชื่อกิลด์
  guild_roleId             String? // ID บทบาทกิลด์ใน Discord
  guild_size               Int? // ขนาดกิลด์
  guild_room_chat          String? // ห้องแชท
  guild_room_mainHall      String? // ห้องโถงหลัก
  guild_room_secondaryHall String? // ห้องโถงรอง
  guild_room_activity      String? // ห้องกิจกรรม
  guild_room_visiting      String? // ห้องเยี่ยมชม
  guild_categoryId         String? // Discord category ID
  GuildMembers             GuildMembers[] // สมาชิกกิลด์
  @@index([serverId])
  @@index([headquartersTargetServerId])
  currentMemberCount       Int            @default(0) // จำนวนสมาชิกปัจจุบัน ใช้จองความจุแบบ atomic
  operationalStatus        GuildOperationalStatus?
  statusReason             String?
  statusChangedAt          DateTime?
  statusChangedBy          String?
}

// รายงานการสร้างกิลด์ - ติดตามกระบวนการสร้างกิลด์
model GuildCreateReport {
  sourceServerName String? // ชื่อ Discord ต้นทาง ณ เวลาลงทะเบียน
  registrationVersion Int? // 2: consent and three-founder registration
  description         String?
  organizationType    String?
  recruitmentMode     String? // PUBLIC | CODE
  recruitmentMessageId String?
  recruitmentChannelId String?
  rulesVersion        String?

  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  ownerId          String // ID เจ้าของกิลด์
  serverId         String // Discord server ID where guild is being created
  channelId        String // ID ช่องที่สร้าง
  messageId        String // ID ข้อความ
  guildName        String // ชื่อกิลด์ที่จะสร้าง
  invitedMembers   String[] // สมาชิกที่ถูกเชิญทั้งหมด
  confirmedMembers String[] @default([]) // สมาชิกที่ยืนยันแล้ว (เริ่มจากเจ้าของ)
  createdAt        DateTime @default(now())
  expiresAt        DateTime // Legacy: 5 minutes; registrationVersion 2: 7 days
  requestCode      String    @unique
  guildType        String    // private | public
  purpose          String    // วัตถุประสงค์ในการก่อตั้งกิลด์
  approvedBy       String? // ผู้อนุมัติคำขอ
  approvedAt       DateTime?
  status           String    @default("PENDING") // PENDING, CREATING, COMPLETED, CANCELLED, FAILED
  failureReason    String?
  completedAt      DateTime?
  officeStatus     GuildApplicationStatus?
  reviewedAt       DateTime?
  reviewedBy       String?
  rejectionReason  String?
  provisionalUntil DateTime?
  @@index([officeStatus, createdAt])
}

// สมาชิกกิลด์ - เก็บข้อมูลสมาชิกในกิลด์
model GuildMembers {
  isFounder Boolean? // Null keeps legacy Leader / Co-founder classification
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId  String?  @db.ObjectId // ID กิลด์
  position String // ตำแหน่งในกิลด์ (เช่น หัวหน้า, รองหัวหน้า, สมาชิก)
  userId   String   @unique // ผู้ใช้เป็นสมาชิกได้หนึ่งกิลด์ในระบบเท่านั้น
  guildDB  GuildDB? @relation(fields: [guildId], references: [id])
}

// โปรไฟล์กิลด์ - ข้อมูลโปรไฟล์และรายละเอียดกิลด์
model GuildProfileDB {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  avatar      String // รูปโปรไฟล์กิลด์
  backdrop    String // ภาพพื้นหลัง
  createdAt   DateTime @db.Date
  createdBy   String
  deleteBy    String
  description String // คำอธิบายกิลด์
  discordlink String // ลิงก์ Discord กิลด์
  guildId     String? // ID กิลด์
  guildname   String // ชื่อกิลด์
  rule        String // กฎกติกากิลด์
  updatedAt   DateTime @db.Date
  updatedBy   String
}

// รายการรูปภาพ - เก็บรูปภาพที่ใช้ในระบบ
model ImageList {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nameFile  String // ชื่อไฟล์
  imageUrl  String   @unique // URL รูปภาพ (ไม่ซ้ำกัน)
  modalName String // ชื่อโมดูล/หน้าที่ใช้
  createdAt DateTime @db.Date
  createdBy String
  updatedAt DateTime @db.Date
  updatedBy String
  deleteBy  String
}

// ข้อมูลคำเชิญกิลด์ - เก็บข้อมูลการเชิญเข้ากิลด์
model GuildInviteDataDB {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  guildId String // ID กิลด์
  userId  String // ID ผู้ใช้ที่ถูกเชิญ
  @@unique([guildId, userId])
}

// คำขอเข้ากิลด์ - เก็บคำขอเข้าร่วมกิลด์
model GuildInviteRequest {
  serverId   String?
  status     String?   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  reason     String?
  createdAt  DateTime? @default(now())
  reviewedAt DateTime?
  reviewedBy String?
  @@unique([guildId, userId])
  @@index([guildId, status])
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  guildId String // ID กิลด์
  userId  String // ID ผู้ใช้ที่ขอเข้า
}

// ========================================
// 📰 News System (ระบบข่าวสาร)
// ========================================

// ข่าวสาร - เก็บข้อมูลข่าวสารและอัพเดท
// Opt-in Discord retention. Do not use MongoDB TTL: Discord must be deleted first.
model DiscordPostRetentionPolicy {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId       String
  channelId     String
  days          Int      @default(30)
  enabled       Boolean  @default(true)
  scanBefore    String?
  scanAfter     DateTime @default(now())
  lastErrorCode String?
  updatedBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([guildId, channelId])
  @@index([enabled, scanAfter])
}

model DiscordPostRetentionDB {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  guildId       String
  channelId     String
  targetId      String
  targetType    String    // MESSAGE or THREAD
  policyId      String?   @db.ObjectId
  createdBy     String?
  postedAt      DateTime
  expiresAt     DateTime
  status        String    @default("PENDING") // PENDING, DELETING, DELETED, CANCELLED
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  leaseToken    String?
  leaseUntil    DateTime?
  deletedAt     DateTime?
  lastErrorCode String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([guildId, targetType, targetId])
  @@index([status, nextAttemptAt, expiresAt])
  @@index([guildId, channelId, status])
}

