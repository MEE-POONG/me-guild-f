  serverName            String // ชื่อเซิร์ฟเวอร์
  Master                Boolean   @default(false) // เซิร์ฟเวอร์หลักหรือไม่
  openBot               Boolean   @default(false) // เปิดใช้งานบอทหรือไม่
  // บทบาท (Roles)
  adminRoleId           String? // ID บทบาทแอดมิน
  wishAltarRoleId       String? // ID บทบาทแท่นขอพรของบอต MeGuild
  userRoleId            String? // ID บทบาทผู้ใช้
  adventurerRoleId      String? // ID บทบาทนักผจญภัย
  visitorRoleId         String? // ID บทบาทผู้เยี่ยมชม
  guildHeadRoleId       String? // ID บทบาทหัวหน้ากิลด์
  guildCoRoleId         String? // ID บทบาทรองหัวหน้ากิลด์
  eccentricRoleId       String? // ID บทบาทพิเศษ
  councilRoleId         String? // ID บทบาทสภา
  councilPresidentRoleId String? // ID บทบาทประธานสภา
  policeRoleId          String? // ID บทบาทตำรวจ
  suspectOneStarRoleId String? @map("prisonerOneStarRoleId") // ID บทบาทผู้ต้องหา 1 ดาว
  suspectTwoStarRoleId String? @map("prisonerTwoStarRoleId") // ID บทบาทผู้ต้องหา 2 ดาว
  suspectThreeStarRoleId String? @map("prisonerThreeStarRoleId") // ID บทบาทผู้ต้องหา 3 ดาว
  prisonerRoleId String? // ID บทบาทนักโทษหลังคำตัดสินและเงื่อนไขที่อนุมัติ
  openUntilAt           DateTime  @db.Date // เปิดใช้งานจนถึงวันที่
  basePackageBillingInterval String? // Calendar billing snapshot; null keeps legacy fixed days
  basePackageBillingAnchorDay Int? // Preserve the original day across shorter months
  maxMusicBots          Int       @default(1) // จำนวน Music Bot สูงสุดที่ใช้ได้ (ตาม package)
  // ตำแหน่งสร้างห้อง (Position Create)
  meguildPositionCreate String? // ตำแหน่งสร้างห้อง MeGuild
  talkPositionCreate    String? // ตำแหน่งสร้างห้องพูดคุย
  gamePositionCreate    String? // ตำแหน่งสร้างห้องเกม
  buskingPositionCreate String? // ตำแหน่งสร้างห้องบัสกิ้ง
  // ช่อง (Channels)
  welcomeChannel        String? // ช่องต้อนรับ
  newsChannel           String? // ช่องข่าวสาร
  registerChannel       String? // ช่องลงทะเบียน
  complaintChannel      String? // ช่องร้องเรียน
  communityAnnouncementChannel String?
  suggestionChannel     String? // ช่องแนะนำ
  tradeChannel          String? // ช่องซื้อขาย
  guildChannel          String? // ช่องกิลด์
  talkChannel           String? // ช่องพูดคุย
  gameChannel           String? // ช่องเกม
  gamePostChannel       String? // ช่องโพสต์เกม
  buskingChannel        String? // ช่องบัสกิ้ง
  createdAt             DateTime  @db.Date
  updatedAt             DateTime  @db.Date
  AdminDB               AdminDB[] // ผู้ดูแลระบบ
  PackageCodeDB         PackageCodeDB[] // โค้ดแพ็กเกจที่ผูกด้วย Discord Guild ID
  basePackageId         String? // Package หลักที่เปิดใช้งานล่าสุด
  basePackagePriceCopper Int? // Paid rate snapshot; catalog edits must not revalue prepaid time
  basePackageDurationDays Int?
  baseMusicBots         Int       @default(1) // จำนวนบอทเพลงจาก package หลัก (ไม่รวม add-on)
  clinicDoctorRoleId    String? // Role ที่ได้รับการอนุมัติให้เปิดบริการคลินิก
  fortuneTellerRoleId   String? // Role ที่อนุญาตให้เปิดห้องหมอดู
  roomSettings          Json? // Managed room configuration; Discord IDs, never role names
