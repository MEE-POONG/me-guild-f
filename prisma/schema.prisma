generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model ActDetailDB {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String // ชื่อกิจกรรม
  description String // รายละเอียดกิจกรรม
  dislink     String // ลิงก์ Discord
  disname     String // ชื่อใน Discord
  img         String // รูปภาพกิจกรรม
  type        String // ประเภทกิจกรรม
  point       String // คะแนนที่ได้รับ
  startdate   String // วันที่เริ่มต้น
  enddate     String // วันที่สิ้นสุด
  createdAt   DateTime @db.Date
  createdBy   String
  updatedAt   DateTime @db.Date
  updatedBy   String
  deleteBy    String
  actType     ActType? @relation(fields: [actTypeId], references: [id]) // ความสัมพันธ์กับประเภทกิจกรรม
  actTypeId   String   @db.ObjectId
}

// ประเภทกิจกรรม - จัดหมวดหมู่กิจกรรม
model ActType {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  name        String // ชื่อประเภทกิจกรรม
  createdAt   DateTime      @db.Date
  createdBy   String
  updatedAt   DateTime      @db.Date
  updatedBy   String
  deleteBy    String
  ActDetailDB ActDetailDB[] // กิจกรรมทั้งหมดในประเภทนี้
}

// ========================================
// 📝 Blog & Content (บล็อกและคอนเทนต์)
// ========================================

// บล็อก - เก็บบทความและเนื้อหา
model BlogDB {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String // หัวข้อบล็อก
  creditlink  String // ลิงก์อ้างอิง/เครดิต
  description String // เนื้อหาบล็อก
  img         String // รูปภาพประกอบ
  video       String // วิดีโอประกอบ
  createdAt   DateTime @db.Date
  createdBy   String
  updatedAt   DateTime @db.Date
  updatedBy   String
  deleteBy    String
}

// ========================================
// ⏱️ User Activity Tracking (ติดตามกิจกรรมผู้ใช้)
// ========================================

// ระบบเช็คออนไลน์ - บันทึกเวลาออนไลน์ของผู้ใช้
model CheckOnlineDB {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  discord_id      String? // Discord ID ของผู้ใช้
  checkIn         DateTime  @default(now()) // เวลาที่เข้าระบบ
  checkOut        DateTime? // เวลาที่ออกจากระบบ
  totalOnlineTime Int       @default(0) // ระยะเวลาออนไลน์ทั้งหมด (วินาที)
  createdAt       DateTime  @default(now())
  createdBy       String?
  updatedAt       DateTime  @updatedAt
  updatedBy       String
  deleteBy        String
}

// ความคิดเห็น - เก็บคอมเมนต์จากผู้ใช้
model CommentDB {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String // ชื่อผู้แสดงความคิดเห็น
  userID    String // ID ของผู้ใช้
  content   String // เนื้อหาความคิดเห็น
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  deleteBy  String?
}

// โค้ดแพ็คเกจ - เก็บโค้ดสำหรับเติมวันใช้งาน
model PackageCodeDB {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  code      String    @unique // รหัสโค้ด
  days      Int // จำนวนวันที่ได้รับ
  isUsed    Boolean   @default(false) // ถูกใช้ไปหรือยัง
  usedBy    String? // ID เซิร์ฟเวอร์ที่ใช้ (Discord Guild ID)
  usedAt    DateTime? // เวลาที่ใช้
  createdAt DateTime  @default(now())
  createdBy String?
}

// ========================================
// 👥 Customer Management (ลูกค้า)
// ========================================

// ข้อมูลลูกค้า - เก็บข้อมูลลูกค้าที่ลงทะเบียน
model CustomerDB {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  discord_id String   @unique // Discord ID (ไม่ซ้ำกัน)
  username   String // ชื่อผู้ใช้
  email      String   @unique // อีเมล (ไม่ซ้ำกัน)
  password   String // รหัสผ่าน
  server     String   @unique // เซิร์ฟเวอร์ (ไม่ซ้ำกัน)
  createdAt  DateTime @db.Date
  createdBy  String
  updatedAt  DateTime @db.Date
  updatedBy  String
  deleteBy   String
}

// ========================================
// 🎮 Game Management (จัดการเกม)
// ========================================

type StoredDecorationImage {
  id              String
  url             String
  key             String?
  filename        String
  mimeType        String
  size            Int
  storageProvider String
  uploadedAt      DateTime
}

// เกมออนไลน์ - เก็บข้อมูลเกมที่รองรับในระบบ
model GameOnlineDB {
  id                   String                 @id @default(auto()) @map("_id") @db.ObjectId
  game_name            String // ชื่อเกมเดิมสำหรับระบบที่ยังอ่านฟิลด์นี้
  nameTh               String? // ชื่อเกมภาษาไทย
  nameEn               String? // ชื่อเกมภาษาอังกฤษ
  shortName            String? // คำย่อชื่อเกม
  logo                 String? // URL โลโก้เกมล่าสุดจาก me-db
  logoFile             StoredDecorationImage? // metadata ไฟล์โลโก้ล่าสุดจาก me-db
  numberMatch          String? // จำนวนแมทช์
  partyLimit           Int // จำนวนผู้เล่นสูงสุดต่อปาร์ตี้
  ranking              Boolean // มีระบบแรงค์หรือไม่
  categoryIds          String[]               @default([]) @db.ObjectId // Categories/แท็กที่ติดกับเกมโดยตรง
  createdAt            DateTime               @db.Date
  createdBy            String?
  updatedAt            DateTime               @db.Date
  updatedBy            String
  deleteBy             String
  // ความสัมพันธ์ many-to-many ผ่าน GameTypeGame
  gameTypeGame         GameTypeGame[]         @relation("GameOnlineToGameTypeGame")
  GameRankDB           GameRankDB[] // แรงค์ของเกม
  GameConditionMatchDB GameConditionMatchDB[] // เงื่อนไขการจับคู่
}

// เงื่อนไขการจับคู่เกม - กำหนดเงื่อนไขสำหรับการจับคู่ผู้เล่น
model GameConditionMatchDB {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  maxParty     Int // จำนวนปาร์ตี้สูงสุด
  limitNumber  Int           @default(0) // จำนวนผู้เล่นจำกัด
  gameOnlineDB GameOnlineDB? @relation(fields: [gameId], references: [id])
  gameId       String        @db.ObjectId
  createdAt    DateTime      @default(now())
  createdBy    String?
  updatedAt    DateTime      @updatedAt
  updatedBy    String
  deleteBy     String
}

// หมวดหมู่เกม - จัดหมวดหมู่เกม
model GameCategoryDB {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String   @unique // ชื่อหมวดหมู่ (ไม่ซ้ำกัน)
  titleEn   String?  // ชื่อหมวดหมู่ภาษาอังกฤษ รองรับข้อมูลเดิมที่ยังไม่มีค่า
  detail    String?  // คำอธิบายขยายความสำหรับใช้เป็นแท็กเกม
  createdAt DateTime @db.Date
  createdBy String
  updatedAt DateTime @db.Date
  updatedBy String
  deleteBy  String
}

// การจับคู่เกม - เก็บข้อมูลการจับคู่ผู้เล่น
model GameMatchDB {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String // ID ผู้ใช้ที่สร้างแมทช์
  gameId       String   @db.ObjectId // ID เกม
  rank         Boolean // เป็นแมทช์แรงค์หรือไม่
  selectRankID String?  @db.ObjectId // แรงค์ที่เลือก
  channel_id   String // ID ช่อง Discord
  partyLimit   Int // จำนวนผู้เล่นสูงสุด
  limitNumber  Int // จำนวนจำกัด
  status       Boolean // สถานะแมทช์ (เปิด/ปิด)
  members      String[] // รายชื่อสมาชิกในแมทช์
  createdAt    DateTime @default(now())
  createdBy    String?
  updatedAt    DateTime @updatedAt
  updatedBy    String
  deleteBy     String
}

// ประเภทเกม - ประเภทย่อยของเกม (เช่น MOBA, FPS, RPG)
model GameTypeDB {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  title        String // ชื่อประเภทเกม
  categoryId   String         @db.ObjectId // หมวดหมู่ของประเภทเกม
  createdAt    DateTime       @db.Date
  createdBy    String
  updatedAt    DateTime       @db.Date
  updatedBy    String
  deleteBy     String
  // ความสัมพันธ์ many-to-many ผ่าน GameTypeGame
  gameTypeGame GameTypeGame[] @relation("GameTypeToGameTypeGame")
}

// ตารางเชื่อมโยง - เชื่อมโยงเกมกับประเภทเกม (Many-to-Many)
model GameTypeGame {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @db.Date
  createdBy String
  updatedAt DateTime @db.Date
  updatedBy String
  deleteBy  String

  // ความสัมพันธ์กับ GameOnlineDB
  gameId       String?       @db.ObjectId
  gameOnlineDB GameOnlineDB? @relation(fields: [gameId], references: [id], onDelete: Cascade, name: "GameOnlineToGameTypeGame")

  // ความสัมพันธ์กับ GameTypeDB
  typeId     String?     @db.ObjectId
  gameTypeDB GameTypeDB? @relation(fields: [typeId], references: [id], onDelete: Cascade, name: "GameTypeToGameTypeGame")
}

// แรงค์ของเกม - เก็บข้อมูลระดับแรงค์ในเกม
model GameRankDB {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  gameOnlineDB GameOnlineDB? @relation(fields: [gameId], references: [id])
  gameId       String?       @db.ObjectId
  imgRank      String // รูปภาพแรงค์
  selcetShow   String? // แสดงในการเลือกหรือไม่
  nameRank     String // ชื่อแรงค์ (เช่น Bronze, Silver, Gold)
  number       Int // ลำดับแรงค์
  createdAt    DateTime      @db.Date
  createdBy    String
  updatedAt    DateTime      @db.Date
  updatedBy    String
  deleteBy     String
}

// ========================================
// 🏰 Guild System (ระบบกิลด์)
// ========================================

// ข้อมูลกิลด์ - เก็บข้อมูลกิลด์หลัก
model GuildDB {
  id                       String         @id @default(auto()) @map("_id") @db.ObjectId
  Logo                     String         @default("https://www.design365print.com/UploadFile/Blog/blog_941976621.jpg") // โลโก้กิลด์
  guild_leader             String? // หัวหน้ากิลด์
  guild_level              Int? // เลเวลกิลด์
  guild_name               String? // ชื่อกิลด์
  guild_roleId             String? // ID บทบาทกิลด์ใน Discord
  guild_size               Int? // ขนาดกิลด์
  guild_room_chat          String? // ห้องแชท
  guild_room_mainHall      String? // ห้องโถงหลัก
  guild_room_secondaryHall String? // ห้องโถงรอง
  guild_room_activity      String? // ห้องกิจกรรม
  guild_room_visiting      String? // ห้องเยี่ยมชม
  guild_categoryId         String? // Discord category ID
  GuildMembers             GuildMembers[] // สมาชิกกิลด์
}

// รายงานการสร้างกิลด์ - ติดตามกระบวนการสร้างกิลด์
model GuildCreateReport {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  ownerId          String // ID เจ้าของกิลด์
  serverId         String // Discord server ID where guild is being created
  channelId        String // ID ช่องที่สร้าง
  messageId        String // ID ข้อความ
  guildName        String // ชื่อกิลด์ที่จะสร้าง
  invitedMembers   String[] // สมาชิกที่ถูกเชิญทั้งหมด
  confirmedMembers String[] @default([]) // สมาชิกที่ยืนยันแล้ว (เริ่มจากเจ้าของ)
  createdAt        DateTime @default(now())
  expiresAt        DateTime // หมดอายุหลังจาก 5 นาที
}

// สมาชิกกิลด์ - เก็บข้อมูลสมาชิกในกิลด์
model GuildMembers {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId  String?  @db.ObjectId // ID กิลด์
  position String // ตำแหน่งในกิลด์ (เช่น หัวหน้า, รองหัวหน้า, สมาชิก)
  userId   String // ID ผู้ใช้
  guildDB  GuildDB? @relation(fields: [guildId], references: [id])
}

// โปรไฟล์กิลด์ - ข้อมูลโปรไฟล์และรายละเอียดกิลด์
model GuildProfileDB {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  avatar      String // รูปโปรไฟล์กิลด์
  backdrop    String // ภาพพื้นหลัง
  createdAt   DateTime @db.Date
  createdBy   String
  deleteBy    String
  description String // คำอธิบายกิลด์
  discordlink String // ลิงก์ Discord กิลด์
  guildId     String? // ID กิลด์
  guildname   String // ชื่อกิลด์
  rule        String // กฎกติกากิลด์
  updatedAt   DateTime @db.Date
  updatedBy   String
}

// รายการรูปภาพ - เก็บรูปภาพที่ใช้ในระบบ
model ImageList {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nameFile  String // ชื่อไฟล์
  imageUrl  String   @unique // URL รูปภาพ (ไม่ซ้ำกัน)
  modalName String // ชื่อโมดูล/หน้าที่ใช้
  createdAt DateTime @db.Date
  createdBy String
  updatedAt DateTime @db.Date
  updatedBy String
  deleteBy  String
}

// ข้อมูลคำเชิญกิลด์ - เก็บข้อมูลการเชิญเข้ากิลด์
model GuildInviteDataDB {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  guildId String // ID กิลด์
  userId  String // ID ผู้ใช้ที่ถูกเชิญ
}

// คำขอเข้ากิลด์ - เก็บคำขอเข้าร่วมกิลด์
model GuildInviteRequest {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  guildId String // ID กิลด์
  userId  String // ID ผู้ใช้ที่ขอเข้า
}

// ========================================
// 📰 News System (ระบบข่าวสาร)
// ========================================

// ข่าวสาร - เก็บข้อมูลข่าวสารและอัพเดท
model NewsUpdateDB {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  title        String // หัวข้อข่าว
  img          String // รูปภาพประกอบข่าว
  creditlink   String // ลิงก์อ้างอิง
  description  String // รายละเอียดข่าว
  createdAt    DateTime       @db.Date
  createdBy    String?
  updatedAt    DateTime?      @db.Date
  updatedBy    String?
  deleteBy     String?
  newsTypeNews NewsTypeNews[] // ประเภทของข่าว
}

// หมวดหมู่ข่าว - จัดหมวดหมู่ข่าว
model NewsCategoryDB {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  title      String // ชื่อหมวดหมู่
  createdAt  DateTime     @db.Date
  createdBy  String
  updatedAt  DateTime     @db.Date
  updatedBy  String
  deleteBy   String
  newsTypeDB NewsTypeDB[] // ประเภทข่าวในหมวดหมู่นี้
}

// ประเภทข่าว - ประเภทย่อยของข่าว
model NewsTypeDB {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  title            String // ชื่อประเภท
  categoryId       String?         @db.ObjectId // ID หมวดหมู่
  createdAt        DateTime        @db.Date
  createdBy        String
  updatedAt        DateTime        @db.Date
  updatedBy        String
  deleteBy         String
  newsTypeNews     NewsTypeNews[]
  newsCategoryDB   NewsCategoryDB? @relation(fields: [newsCategoryDBId], references: [id])
  newsCategoryDBId String?         @db.ObjectId
}

// ตารางเชื่อมโยง - เชื่อมโยงข่าวกับประเภทข่าว (Many-to-Many)
model NewsTypeNews {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  typeId       String?       @db.ObjectId
  createdAt    DateTime      @db.Date
  createdBy    String
  updatedAt    DateTime      @db.Date
  updatedBy    String
  deleteBy     String
  newsUpdateDB NewsUpdateDB? @relation(fields: [newsUpdateId], references: [id])
  newsUpdateId String?       @db.ObjectId
  newsTypeDB   NewsTypeDB?   @relation(fields: [newsTypeId], references: [id])
  newsTypeId   String?       @db.ObjectId
}

// ========================================
// 🖥️ Server Configuration (การตั้งค่าเซิร์ฟเวอร์)
// ========================================

// ข้อมูลเซิร์ฟเวอร์ - เก็บการตั้งค่าเซิร์ฟเวอร์ Discord
model ServerDB {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  ownerId               String // ID เจ้าของเซิร์ฟเวอร์
  serverId              String    @unique // Discord Server ID (ไม่ซ้ำกัน)
  serverName            String // ชื่อเซิร์ฟเวอร์
  Master                Boolean   @default(false) // เซิร์ฟเวอร์หลักหรือไม่
  openBot               Boolean   @default(false) // เปิดใช้งานบอทหรือไม่
  // บทบาท (Roles)
  adminRoleId           String? // ID บทบาทแอดมิน
  userRoleId            String? // ID บทบาทผู้ใช้
  adventurerRoleId      String? // ID บทบาทนักผจญภัย
  visitorRoleId         String? // ID บทบาทผู้เยี่ยมชม
  guildHeadRoleId       String? // ID บทบาทหัวหน้ากิลด์
  guildCoRoleId         String? // ID บทบาทรองหัวหน้ากิลด์
  eccentricRoleId       String? // ID บทบาทพิเศษ
  openUntilAt           DateTime  @db.Date // เปิดใช้งานจนถึงวันที่
  maxMusicBots          Int       @default(1) // จำนวน Music Bot สูงสุดที่ใช้ได้ (ตาม package)
  // ตำแหน่งสร้างห้อง (Position Create)
  meguildPositionCreate String? // ตำแหน่งสร้างห้อง MeGuild
  talkPositionCreate    String? // ตำแหน่งสร้างห้องพูดคุย
  gamePositionCreate    String? // ตำแหน่งสร้างห้องเกม
  buskingPositionCreate String? // ตำแหน่งสร้างห้องบัสกิ้ง
  // ช่อง (Channels)
  welcomeChannel        String? // ช่องต้อนรับ
  newsChannel           String? // ช่องข่าวสาร
  registerChannel       String? // ช่องลงทะเบียน
  complaintChannel      String? // ช่องร้องเรียน
  suggestionChannel     String? // ช่องแนะนำ
  tradeChannel          String? // ช่องซื้อขาย
  guildChannel          String? // ช่องกิลด์
  talkChannel           String? // ช่องพูดคุย
  gameChannel           String? // ช่องเกม
  gamePostChannel       String? // ช่องโพสต์เกม
  buskingChannel        String? // ช่องบัสกิ้ง
  createdAt             DateTime  @db.Date
  updatedAt             DateTime  @db.Date
  AdminDB               AdminDB[] // ผู้ดูแลระบบ
}

// ========================================
// 👤 User Management (จัดการผู้ใช้)
// ========================================

// ข้อมูลผู้ใช้ - เก็บข้อมูลผู้ใช้ในระบบ
model UserDB {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  username          String? // ชื่อผู้ใช้
  password          String? // รหัสผ่าน
  discord_id        String        @unique // Discord ID (ไม่ซ้ำกัน)
  img               String? // รูปโปรไฟล์
  firstname         String? // ชื่อจริง
  lastname          String? // นามสกุล
  nickname          String? // ชื่อเล่น
  email             String        @unique // อีเมล (ไม่ซ้ำกัน)
  tel               String? // เบอร์โทรศัพท์
  birthday          DateTime?     @db.Date // วันเกิด
  gender            String? // เพศสภาพ
  alternativeGender String? // เพศที่เป็น
  createdAt         DateTime      @db.Date
  createdBy         String
  deleteBy          String
  updatedAt         DateTime      @db.Date
  updatedBy         String
  AdminDB           AdminDB[] // บัญชีแอดมิน (ถ้ามี)
  OrderItemDB       OrderItemDB[] // รายการสั่งซื้อ
}

// แรงค์เกมของผู้ใช้ - เก็บข้อมูลแรงค์ในเกมของผู้ใช้
model UserGameRank {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  gameId     String   @db.ObjectId // ID เกม
  gameRankId String   @db.ObjectId // ID แรงค์
  invitation Boolean // เปิดรับคำเชิญหรือไม่
  createdAt  DateTime @db.Date
  createdBy  String
  updatedAt  DateTime @db.Date
  updatedBy  String
  deleteBy   String
  /// Multiple data types found: String: 85.7%, String (ObjectId): 14.3% out of 14 sampled entries
  userId     Json // ID ผู้ใช้ (รองรับหลายประเภท)
}

// ========================================
// 🌐 Website Settings (การตั้งค่าเว็บไซต์)
// ========================================

// การตั้งค่าเริ่มต้นเว็บ - เก็บการตั้งค่าพื้นฐานของเว็บไซต์
model WebDefaultDB {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  logoSquare     String? // โลโก้รูปสี่เหลี่ยม
  logoCircle     String? // โลโก้รูปวงกลม
  logoWide       String? // โลโก้แบบกว้าง
  defaultImg     String? // รูปภาพเริ่มต้น
  defaultProfile String? // รูปโปรไฟล์เริ่มต้น
  // โซเชียลมีเดีย
  facebook       String? // ลิงก์ Facebook
  instagram      String? // ลิงก์ Instagram
  youtube        String? // ลิงก์ YouTube
  tiktok         String? // ลิงก์ TikTok
  gmail          String? // อีเมล Gmail
  discordLink    String? // ลิงก์ Discord
  createdAt      DateTime @default(now())
  createdBy      String?
  updatedAt      DateTime @updatedAt
  updatedBy      String
  deleteBy       String
}

// บทบาท Discord - เก็บข้อมูลบทบาทใน Discord
model RoleDiscord {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  img             String? // รูปภาพบทบาท
  name            String // ชื่อบทบาท
  roldID          String // ID บทบาทใน Discord
  discordServerID String // ID เซิร์ฟเวอร์ Discord
  type            String? // ประเภท (กิจกรรม, ขาย, แจก)
  createdAt       DateTime @default(now())
  createdBy       String?
  updatedAt       DateTime @updatedAt
  updatedBy       String
  deleteBy        String
}

// ========================================
// 🛒 E-Commerce System (ระบบซื้อขาย)
// ========================================

// สินค้า Discord - เก็บข้อมูลสินค้าที่ขายในระบบ
model ProductDiscordDB {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  name            String // ชื่อสินค้า
  img             String? // รูปภาพสินค้า
  description     String // รายละเอียดสินค้า
  discordServerID String? // ID เซิร์ฟเวอร์ Discord
  type            String // ประเภทสินค้า
  singlePurchase  Boolean       @default(false) // ซื้อได้แค่ 1 ชิ้นต่อคน
  roleId          String? // ID บทบาทที่ได้รับเมื่อซื้อ
  price           Float // ราคา
  createdAt       DateTime      @default(now())
  createdBy       String?
  updatedAt       DateTime?     @updatedAt
  updatedBy       String?
  deleteBy        String?
  OrderItemDB     OrderItemDB[] // รายการสั่งซื้อ
}

// ออเดอร์ - เก็บข้อมูลคำสั่งซื้อ
model OrderDB {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  buyerDiscordID String // Discord ID ของผู้ซื้อ
  name           String // ชื่อผู้ซื้อ
  email          String // อีเมลผู้ซื้อ
  tel            String? // เบอร์โทรศัพท์ผู้ซื้อ
  totalPrice     Float // ราคารวมทั้งหมด
  seller         AdminDB       @relation(fields: [sellerID], references: [id])
  sellerID       String        @db.ObjectId // ID ผู้ขาย
  sellerName     String // ชื่อผู้ขาย
  status         OrderStatus   @default(DRAFT) // สถานะออเดอร์
  note           String? // หมายเหตุ
  createdAt      DateTime      @default(now())
  createdBy      String?
  updatedAt      DateTime?     @updatedAt
  updatedBy      String?
  deleteBy       String?
  items          OrderItemDB[] // รายการสินค้าในออเดอร์
  payments       PaymentDB[] // ข้อมูลการชำระเงิน (สามารถมีหลาย payment ได้)
}

// รายการสินค้าในออเดอร์ - เก็บรายละเอียดสินค้าแต่ละชิ้นในออเดอร์
model OrderItemDB {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  orderId      String           @db.ObjectId // ID ออเดอร์
  recipient    UserDB           @relation(fields: [recipientId], references: [id])
  recipientId  String           @db.ObjectId // ผู้รับสินค้า
  order        OrderDB          @relation(fields: [orderId], references: [id])
  productId    String           @db.ObjectId // ID สินค้า
  product      ProductDiscordDB @relation(fields: [productId], references: [id])
  quantity     Int              @default(1) // จำนวนสินค้า
  pricePerItem Float // ราคาต่อชิ้น
  totalPrice   Float // ราคารวม (quantity × pricePerItem)
}

// สถานะออเดอร์ - กำหนดสถานะต่างๆ ของออเดอร์
enum OrderStatus {
  DRAFT // แบบร่าง (สีเหลือง)
  PENDING // รอชำระเงิน (สีส้ม)
  PAID // ชำระเงินแล้ว (สีเขียว)
  WAITING // รอชำระอีกรอบ (สีฟ้าอมเขียว)
  COMPLETED // สำเร็จ (สีเขียวมรกต)
  CANCELLED // ยกเลิก (สีแดง)
}

// การชำระเงิน - เก็บข้อมูลการชำระเงิน
model PaymentDB {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  paymentSlip   String? // URL สลิปการชำระเงิน (Optional for Stripe)
  paymentMethod String // วิธีการชำระเงิน (PayPal, TrueMoney, Crypto, PromptPay)
  auditor       AdminDB? @relation(fields: [auditorID], references: [id])
  auditorID     String?  @db.ObjectId // ผู้ตรวจสอบ
  auditorName   String? // ชื่อผู้ตรวจสอบ

  // Stripe Fields
  stripePaymentIntentId String? @unique
  stripeAmount          Int? // Amount in satang
  currency              String?
  status                String? // PENDING, SUCCEEDED, etc.
  qrCodeUrl             String?
  metadata              Json?

  // Discord Message Tracking (for updating QR code message on success)
  discordChannelId String? // Channel where QR message was sent
  discordMessageId String? // Message ID of the QR code message
  discordUserId    String? // User who initiated the payment
  discordGuildId   String? // Guild where payment was initiated

  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime? @updatedAt
  updatedBy String?
  orderDB   OrderDB?  @relation(fields: [orderId], references: [id])
  orderId   String?   @db.ObjectId // ID ออเดอร์ที่เชื่อมโยง (optional for package subscriptions)
}

// ========================================
// 💰 Currency & Economy (สกุลเงินและเศรษฐกิจ)
// ========================================

// เหรียญ MeGuild - เก็บข้อมูลสกุลเงินในเกมของผู้ใช้
model MeGuildCoinDB {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  coin_copper Int      @default(0) // เหรียญทองแดง
  // coin_iron     Int // เหรียญเหล็ก
  // coin_silver   Int // เหรียญเงิน
  // coin_gold     Int // เหรียญทอง
  // coin_platinum Int // เหรียญแพลตินัม
  // coin_diamond  Int // เหรียญเพชร
  // coin_crystal  Int // เหรียญคริสตัล
  // coin_mythic   Int // เหรียญมิธิค
  // coin_arcane   Int // เหรียญอาร์เคน
  // coin_divine   Int // เหรียญดิไวน์
  // coin_cosmic   Int // เหรียญคอสมิก
  createdAt   DateTime @db.Date
  updatedAt   DateTime @db.Date
  userId      String // ID ผู้ใช้
}

// ========================================
// 📜 Rules & Regulations (กฎและระเบียบ)
// ========================================

// กฎ - เก็บข้อมูลกฎของกิลด์
model RuleDB {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  topic     String // หัวข้อกฎ
  IssueBy   Int // ผู้ออกกฎ
  GuildID   String // ID กิลด์
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String
  deleteBy  String
}

// หัวข้อ - หัวข้อย่อยของกฎ
model topicDB {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String // ชื่อหัวข้อ
  ruleId      Int // ID กฎที่เกี่ยวข้อง
  description String // คำอธิบาย
  createdAt   DateTime @default(now())
  createdBy   String?
  updatedAt   DateTime @updatedAt
  updatedBy   String
  deleteBy    String
}

// ========================================
// 👥 Team Management (จัดการทีม)
// ========================================

// ทีม - เก็บข้อมูลทีมและสมาชิก
model TeamDB {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  teamName   String // ชื่อทีม
  represent  String // ตัวแทนทีม/สังกัด
  members    String[] // รายชื่อสมาชิก (discord_id หรือ userId)
  TeamLeader String? // หัวหน้าทีม
  createdAt  DateTime @default(now())
  createdBy  String?
  updatedAt  DateTime @updatedAt
  updatedBy  String
  deleteBy   String
}

// ========================================
// 👔 Admin Management (จัดการผู้ดูแลระบบ)
// ========================================

// ผู้ดูแลระบบ - เก็บข้อมูลแอดมิน
model AdminDB {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  username        String           @unique // ชื่อผู้ใช้ (ไม่ซ้ำกัน)
  password        String // รหัสผ่าน
  name            String // ชื่อ-นามสกุล
  tel             String // เบอร์โทรศัพท์
  email           String // อีเมล
  serverDB        ServerDB?        @relation(fields: [discordServerID], references: [id])
  discordServerID String?          @db.ObjectId // เซิร์ฟเวอร์ที่ดูแล
  UserDB          UserDB?          @relation(fields: [userId], references: [id])
  userId          String?          @db.ObjectId // เชื่อมโยงกับผู้ใช้
  createdAt       DateTime         @default(now())
  createdBy       String
  updatedAt       DateTime         @updatedAt
  updatedBy       String           @default("")
  deleteBy        String
  AdminPositionDB AdminPositionDB? @relation(fields: [adminPositionId], references: [id])
  adminPositionId String?          @db.ObjectId // ตำแหน่งแอดมิน
  OrderDB         OrderDB[] // ออเดอร์ที่จัดการ
  PaymentDB       PaymentDB[] // การชำระเงินที่ตรวจสอบ
}

// สิทธิ์เริ่มต้นของแอดมิน - กำหนดสิทธิ์การเข้าถึงแต่ละหน้า
model AdminDefaultPermissionDB {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  AdminPositionDB   AdminPositionDB? @relation(fields: [adminPositionDBId], references: [id])
  adminPositionDBId String?          @db.ObjectId // ตำแหน่งที่ได้รับสิทธิ์
  MenuPageWeb       MenuPageWebDB?   @relation(fields: [menuPageWebId], references: [id])
  menuPageWebId     String?          @db.ObjectId // หน้าเว็บที่ควบคุม
  // สิทธิ์การใช้งาน
  canAdvance        Boolean          @default(false) // ใช้ฟีเจอร์ขั้นสูง
  canViews          Boolean          @default(false) // ดูข้อมูล
  canCreate         Boolean          @default(false) // สร้างข้อมูล
  canUpdate         Boolean          @default(false) // แก้ไขข้อมูล
  canDelete         Boolean          @default(false) // ลบข้อมูล
  createdAt         DateTime         @default(now())
  createdBy         String
  updatedAt         DateTime         @updatedAt
  updatedBy         String           @default("")
  deleteBy          String
}

// เมนูหน้าเว็บ - กำหนดโครงสร้างเมนูและสิทธิ์การเข้าถึง
model MenuPageWebDB {
  id                       String                     @id @default(auto()) @map("_id") @db.ObjectId
  name                     String // ชื่อหน้า (dashboard, users, settings)
  description              String? // คำอธิบาย
  itOn                     Boolean                    @default(false) // เปิดใช้งานหรือไม่
  showOrder                Int?                       @default(0) // ลำดับการแสดง
  head                     Boolean                    @default(false) // เป็นหัวเมนูหรือไม่
  link                     String // ลิงก์หน้า
  icon                     String? // ไอคอน (ชื่อหรือ URL)
  manager                  String[]                   @default([]) // หน้าย่อยจำเพาะ (เพิ่ม แก้ไข แสดง)
  subMenu                  String[] // เมนูลูก (ตรวจสอบจาก parentId)
  parentId                 String?                    @db.ObjectId // ID เมนูแม่
  // สิทธิ์พื้นฐาน
  canAdvance               Boolean?                   @default(false)
  canViews                 Boolean?                   @default(false)
  canCreate                Boolean?                   @default(false)
  canUpdate                Boolean?                   @default(false)
  canDelete                Boolean?                   @default(false)
  createdAt                DateTime                   @default(now())
  createdBy                String
  updatedAt                DateTime                   @updatedAt
  updatedBy                String                     @default("")
  deleteBy                 String
  AdminDefaultPermissionDB AdminDefaultPermissionDB[]
}

// แผนกแอดมิน - จัดกลุ่มตำแหน่งแอดมิน
model AdminDepartmentDB {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  name            String            @unique // ชื่อแผนก (ไม่ซ้ำกัน)
  managerId       String?           @db.ObjectId // ผู้จัดการแผนก
  adminPositionDB AdminPositionDB[] // ตำแหน่งในแผนก
  createdAt       DateTime          @default(now())
  createdBy       String
  updatedAt       DateTime          @updatedAt
  updatedBy       String            @default("")
  deleteBy        String
}

// ตำแหน่งแอดมิน - กำหนดตำแหน่งและระดับสิทธิ์
model AdminPositionDB {
  id                       String                     @id @default(auto()) @map("_id") @db.ObjectId
  name                     String // ชื่อตำแหน่ง
  priority                 Int // ลำดับความสำคัญ
  adminDepartmentId        String?                    @db.ObjectId
  adminDepartmentDB        AdminDepartmentDB?         @relation(fields: [adminDepartmentId], references: [id], onDelete: Cascade)
  adminDB                  AdminDB[] // แอดมินในตำแหน่งนี้
  createdAt                DateTime                   @default(now())
  createdBy                String
  updatedAt                DateTime                   @updatedAt
  updatedBy                String                     @default("")
  deleteBy                 String
  AdminDefaultPermissionDB AdminDefaultPermissionDB[] // สิทธิ์ของตำแหน่ง
}

// ========================================
// 📊 Miscellaneous (อื่นๆ)
// ========================================

// การซื้อขายแรงค์ - เก็บประวัติการซื้อขายแรงค์/บทบาท
model TradingofRanks {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  userID    String // ID ผู้ใช้
  roleID    String // ID บทบาท
  paymentID String // ID การชำระเงิน
}

// เวลาในห้องเสียง - ติดตามเวลาที่ผู้ใช้อยู่ในห้องเสียง
model VoiceTime {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String // ID ผู้ใช้
  channelId String   @default("") // ID ช่องเสียง
  duration  Int // ระยะเวลา (วินาที)
  timestamp DateTime @default(now()) // เวลาที่บันทึก
}

// ========================================
// 🤖 Discord Bot Configuration (การตั้งค่า Bot)
// ========================================

// การตั้งค่า Discord Bot - เก็บ Token และ Guild ID (รองรับหลาย bot)
model DiscordBotConfig {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  botToken  String   @unique // Discord Bot Token (ไม่ซ้ำกัน)
  guildId   String // Discord Guild/Server ID
  botName   String? // ชื่อ Bot (optional)
  isActive  Boolean  @default(true) // เปิดใช้งานหรือไม่
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  deleteBy  String?

  @@unique([botToken, guildId]) // ไม่ให้ token เดียวกันซ้ำใน guild เดียวกัน
}

// ========================================
// 🎁 Event & Reward System (ระบบกิจกรรมและรางวัล)
// ========================================

// ไอเทม - รายการไอเทมในระบบ
model ItemDB {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  name            String // ชื่อไอเทม
  description     String? // คำอธิบาย
  imageUrl        String? // รูปภาพไอเทม
  rarity          String? // ความหายาก (common, rare, epic, legendary)
  isStackable     Boolean           @default(true) // สะสมได้หรือไม่
  maxStack        Int?              @default(99) // จำนวนสูงสุดต่อช่อง
  createdAt       DateTime          @default(now())
  createdBy       String?
  updatedAt       DateTime          @updatedAt
  updatedBy       String?
  deleteBy        String?
  EventReward     EventReward[] // รางวัลที่เป็นไอเทมนี้
  UserInventoryDB UserInventoryDB[] // คลังที่มีไอเทมนี้
}

// คลังของผู้ใช้ - เก็บไอเทมที่ผู้ใช้มี
model UserInventoryDB {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String // Discord ID ของผู้ใช้
  itemId    String   @db.ObjectId // ID ไอเทม
  item      ItemDB   @relation(fields: [itemId], references: [id])
  quantity  Int      @default(1) // จำนวนที่มี
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, itemId]) // ผู้ใช้คนเดียวมีไอเทมชิ้นเดียวได้แค่ 1 record
}

// กิจกรรม - กิจกรรมแจกของรางวัล
model EventCampaign {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  guildId           String // Discord Guild ID
  title             String // ชื่อกิจกรรม
  description       String? // คำอธิบายกิจกรรม
  imageUrl          String? // รูปภาพกิจกรรม
  eventType         EventType // ประเภทกิจกรรม (ACCUMULATE_TIME, LOGIN_INSTANT, SEQUENTIAL_CLAIM)
  frequency         FrequencyType // ความถี่ (DAILY, WEEKLY, MONTHLY, ONE_TIME)
  startDate         DateTime // วันเริ่มกิจกรรม
  endDate           DateTime // วันสิ้นสุดกิจกรรม
  isActive          Boolean             @default(true) // เปิดใช้งานหรือไม่
  resetOnMissed     Boolean             @default(false) // รีเซ็ต streak ถ้าพลาด (สำหรับ LOGIN_INSTANT)
  createdAt         DateTime            @default(now())
  createdBy         String?
  updatedAt         DateTime            @updatedAt
  updatedBy         String?
  deleteBy          String?
  EventReward       EventReward[] // รางวัลในกิจกรรม
  EventUserProgress EventUserProgress[] // ความคืบหน้าของผู้ใช้
}

// ประเภทกิจกรรม
enum EventType {
  ACCUMULATE_TIME // แบบ A: ออนไลน์สะสมเวลา
  LOGIN_INSTANT // แบบ B: ล็อกอินรับทันที
  SEQUENTIAL_CLAIM // แบบ C: ต้องรับก่อนถึงนับต่อ
}

// ความถี่กิจกรรม
enum FrequencyType {
  DAILY // รายวัน
  WEEKLY // รายสัปดาห์
  MONTHLY // รายเดือน
  ONE_TIME // ครั้งเดียว (ไม่รีเซ็ต)
}

// รางวัล - รายการรางวัลในกิจกรรม
model EventReward {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  campaignId     String           @db.ObjectId // ID กิจกรรม
  campaign       EventCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  rewardOrder    Int // ลำดับรางวัล (1, 2, 3, ...)
  rewardType     RewardType // ประเภทรางวัล (COIN, ROLE, ITEM)
  // เงื่อนไข (ใช้ตาม eventType)
  requiredTime   Int? // เวลาที่ต้องสะสม (วินาที) สำหรับ ACCUMULATE_TIME
  requiredDay    Int? // วันที่ต้องล็อกอิน (วันที่ 1, 2, 3...) สำหรับ LOGIN_INSTANT
  // รางวัล
  coinType       String? // ประเภทเหรียญ (copper, silver, gold, crystal, diamond)
  coinAmount     Int? // จำนวนเหรียญ
  roleId         String? // Discord Role ID
  itemId         String?          @db.ObjectId // ID ไอเทม
  item           ItemDB?          @relation(fields: [itemId], references: [id])
  itemQuantity   Int?             @default(1) // จำนวนไอเทม
  createdAt      DateTime         @default(now())
  createdBy      String?
  updatedAt      DateTime         @updatedAt
  updatedBy      String?
  deleteBy       String?
  EventUserClaim EventUserClaim[] // ประวัติการรับ
}

// ประเภทรางวัล
enum RewardType {
  COIN // เหรียญ
  ROLE // Discord Role
  ITEM // ไอเทม
}

// ความคืบหน้าของผู้ใช้ - ติดตามความคืบหน้าในกิจกรรม
model EventUserProgress {
  id                  String        @id @default(auto()) @map("_id") @db.ObjectId
  userId              String // Discord ID ของผู้ใช้
  campaignId          String        @db.ObjectId // ID กิจกรรม
  campaign            EventCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // ความคืบหน้า (ใช้ตาม eventType)
  accumulatedTime     Int           @default(0) // เวลาสะสม (วินาที) สำหรับ ACCUMULATE_TIME
  loginDays           Int           @default(0) // จำนวนวันที่ล็อกอิน สำหรับ LOGIN_INSTANT
  currentStreak       Int           @default(0) // streak ปัจจุบัน (ติดต่อกัน)
  lastLoginDate       DateTime? // วันที่ล็อกอินล่าสุด
  lastRewardOrder     Int           @default(0) // รางวัลล่าสุดที่รับ (สำหรับ SEQUENTIAL_CLAIM)
  lastCheckTime       DateTime? // เวลาที่เช็คล่าสุด (สำหรับ notification)
  hasBeenNotified     Boolean       @default(false) // ถูกแจ้งเตือนแล้วหรือยัง
  // สำหรับ voice tracking (ACCUMULATE_TIME)
  currentSessionStart DateTime? // เวลาเริ่มเข้า voice channel (session ปัจจุบัน)
  isCurrentlyInVoice  Boolean       @default(false) // อยู่ใน voice หรือไม่
  voiceChannelId      String? // ID ของ voice channel ปัจจุบัน
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([userId, campaignId]) // ผู้ใช้คนเดียวมี progress เดียวต่อกิจกรรม
}

// ประวัติการรับรางวัล - บันทึกการรับของ
model EventUserClaim {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  userId     String // Discord ID ของผู้ใช้
  rewardId   String      @db.ObjectId // ID รางวัล
  reward     EventReward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  claimedAt  DateTime    @default(now()) // เวลาที่รับ
  periodDate DateTime // วัน/สัปดาห์/เดือน ที่รับ (สำหรับตรวจสอบ duplicate)

  @@unique([userId, rewardId, periodDate]) // ไม่ให้รับรางวัลเดียวกันซ้ำในรอบเดียวกัน
}

// ประเภทเหรียญ - เก็บข้อมูลชนิดของเหรียญในระบบ
model CoinTypeDB {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  key          String  @unique // key ภายในระบบ เช่น COPPER, SILVER, GOLD
  name         String // ชื่อเหรียญที่แสดง เช่น เหรียญทองแดง
  description  String? // คำอธิบายเพิ่มเติม
  iconUrl      String? // URL รูปไอคอนเหรียญ
  displayOrder Int     @default(0) // ลำดับการแสดงผล
  isPremium    Boolean @default(false) // เหรียญพรีเมียมไหม
  isActive     Boolean @default(true) // ปิด/เปิดการใช้งานเหรียญนี้

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  deleteBy  String?

  CoinTransactionDB CoinTransactionDB[] // ทรานแซคชันที่ใช้เหรียญชนิดนี้
}

// ประวัติการเคลื่อนไหวเหรียญ - บันทึกทุกครั้งที่มีการเพิ่ม/ลดเหรียญ
model CoinTransactionDB {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String // Discord ID หรือ userId ตามที่ใช้งานจริง
  // ถ้าผูกกับ UserDB:
  // user        UserDB?      @relation(fields: [userId], references: [id])

  coinTypeId String     @db.ObjectId // อ้างอิงชนิดเหรียญ
  coinType   CoinTypeDB @relation(fields: [coinTypeId], references: [id])

  amount        Int // จำนวนเหรียญ + เพิ่ม / - ลด
  balanceBefore Int? // ยอดก่อนหน้า (optional แต่ช่วย debug ง่าย)
  balanceAfter  Int? // ยอดหลังอัปเดต

  // ที่มาของการเปลี่ยนแปลง
  sourceType String // แหล่งที่มา เช่น "EVENT", "SHOP", "ADMIN_ADJUST", "COMMAND"
  sourceId   String? // ID อ้างอิง เช่น eventId, orderId, messageId

  note String? // หมายเหตุเพิ่มเติม

  createdAt DateTime @default(now())
  createdBy String? // ใครเป็นคน trigger เช่น system, userId แอดมิน
}

// กระเป๋าเหรียญของผู้ใช้ (รองรับหลายกระเป๋า เช่น ต่อเซิร์ฟเวอร์)
model UserWalletDB {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  userId  String // ID ผู้ใช้
  guildId String? // ถ้าผูกตาม Discord Guild/Server
  name    String? // ชื่อกระเป๋า เช่น "Main", "Guild-A"

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  deleteBy  String?
}

// ========================================
// 🎵 Music Bot Management (จัดการบอทเพลง)
// ========================================

// บอทเพลง - เก็บข้อมูล Music Bot แต่ละตัว
model MusicBotDB {
  id             String             @id @default(auto()) @map("_id") @db.ObjectId
  name           String // ชื่อ Music Bot
  clientId       String             @unique // Discord Client ID
  token          String // Discord Bot Token (encrypted recommended)
  inviteUrl      String // OAuth2 Invite URL พร้อม permissions
  status         MusicBotStatus     @default(AVAILABLE) // สถานะบอท
  maxGuilds      Int                @default(100) // จำนวน guild สูงสุดที่รองรับ
  currentGuilds  Int                @default(0) // จำนวน guild ปัจจุบัน
  description    String? // คำอธิบายเพิ่มเติม
  avatarUrl      String? // URL รูปโปรไฟล์บอท
  isActive       Boolean            @default(true) // เปิดใช้งานหรือไม่
  createdAt      DateTime           @default(now())
  createdBy      String?
  updatedAt      DateTime           @updatedAt
  updatedBy      String?
  deleteBy       String?
  // ความสัมพันธ์
  ServerMusicBot ServerMusicBotDB[] // เซิร์ฟเวอร์ที่ใช้บอทนี้
}

// สถานะบอทเพลง
enum MusicBotStatus {
  AVAILABLE // พร้อมใช้งาน
  ASSIGNED // ถูก assign แล้วแต่ยังมีที่ว่าง
  FULL // เต็มแล้ว
  OFFLINE // ออฟไลน์/ปิดใช้งาน
}

// เซิร์ฟเวอร์-บอทเพลง - Junction table เชื่อม Server กับ Music Bot
model ServerMusicBotDB {
  id          String               @id @default(auto()) @map("_id") @db.ObjectId
  serverId    String // Discord Guild ID
  musicBotId  String               @db.ObjectId // ID ของ Music Bot
  musicBot    MusicBotDB           @relation(fields: [musicBotId], references: [id], onDelete: Cascade)
  status      ServerMusicBotStatus @default(PENDING_INVITE) // สถานะการ invite
  invitedBy   String? // Discord User ID ของผู้ที่ invite
  assignedAt  DateTime             @default(now()) // เวลาที่ assign
  activatedAt DateTime? // เวลาที่ bot เข้า guild สำเร็จ
  removedAt   DateTime? // เวลาที่ถูกลบออก
  createdAt   DateTime             @default(now())
  createdBy   String?
  updatedAt   DateTime             @updatedAt
  updatedBy   String?

  @@unique([serverId, musicBotId]) // ไม่ให้ bot ตัวเดียวกันซ้ำใน guild เดียวกัน
}

// สถานะการ invite บอทเพลงในเซิร์ฟเวอร์
enum ServerMusicBotStatus {
  PENDING_INVITE // รอการ invite (ส่ง link แล้ว)
  ACTIVE // เข้า guild แล้ว กำลังใช้งาน
  REMOVED // ถูกลบออกจาก guild
  FAILED // invite ไม่สำเร็จ
}

// Profile collections are intentionally separate from the legacy UserDB collection.
// ownerEmail preserves legacy profiles; identityId binds verified accounts without changing legacy IDs.
model MemberProfile {
  id           String               @id @default(auto()) @map("_id") @db.ObjectId
  identityId   String?              @db.ObjectId
  ownerEmail   String               @unique
  slug         String               @unique
  displayName  String
  headline     String?
  bio          String?
  avatarUrl    String?
  bannerUrl    String?
  location     String?
  websiteUrl   String?
  statusText   String?
  isPublic     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  preference   MemberPreference?
  sections     ProfileSection[]
  songs        ProfileSong[]
  foods        ProfileFood[]
  achievements ProfileAchievement[]
  customItems  ProfileCustomItem[]

  @@index([identityId])
  @@map("MeGuildMemberProfile")
}

model MemberPreference {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  profileId         String        @unique @db.ObjectId
  profile           MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  locale            SiteLocale    @default(TH)
  colorMode         ColorMode     @default(DARK)
  profileTheme      ProfileTheme  @default(NEON)
  showLocaleBadge   Boolean       @default(true)
  autoplayMusic     Boolean       @default(false)
  reducedMotion     Boolean       @default(false)
  compactNavigation Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("MeGuildMemberPreference")
}

model ProfileSection {
  id        String             @id @default(auto()) @map("_id") @db.ObjectId
  profileId String             @db.ObjectId
  profile   MemberProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type      ProfileSectionType
  title     String?
  isVisible Boolean            @default(true)
  position  Int                @default(0)
  layout    DisplayLayout      @default(GRID)
  settings  Json?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([profileId, type])
  @@index([profileId, position])
  @@map("MeGuildProfileSection")
}

model ProfileSong {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  profileId   String        @db.ObjectId
  profile     MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  artist      String
  album       String?
  artworkUrl  String?
  externalUrl String?
  previewUrl  String?
  provider    String?
  accentColor String?
  position    Int           @default(0)
  isVisible   Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([profileId, position])
  @@map("MeGuildProfileSong")
}

model ProfileFood {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  profileId   String        @db.ObjectId
  profile     MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  cuisine     String?
  description String?
  imageUrl    String?
  rating      Int?
  position    Int           @default(0)
  isVisible   Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([profileId, position])
  @@map("MeGuildProfileFood")
}

model ProfileAchievement {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  profileId   String        @db.ObjectId
  profile     MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  description String?
  icon        String?
  imageUrl    String?
  rarity      String?
  source      String?
  isVerified  Boolean       @default(false)
  unlockedAt  DateTime?
  position    Int           @default(0)
  isVisible   Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([profileId, position])
  @@map("MeGuildProfileAchievement")
}

model ProfileCustomItem {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  profileId   String        @db.ObjectId
  profile     MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category    String
  title       String
  subtitle    String?
  description String?
  imageUrl    String?
  externalUrl String?
  metadata    Json?
  position    Int           @default(0)
  isVisible   Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([profileId, category, position])
  @@map("MeGuildProfileCustomItem")
}

enum SiteLocale {
  TH
  ZH
  EN
  JA
}

enum ColorMode {
  LIGHT
  DARK
}

enum ProfileTheme {
  NEON
  SAKURA
  ARCADE
  MINIMAL
  FANTASY
}

enum ProfileSectionType {
  ABOUT
  GAMES
  MUSIC
  ACHIEVEMENTS
  FOOD
  GUILDS
  ACTIVITY
  CUSTOM
}

enum DisplayLayout {
  GRID
  LIST
  STACK
  BENTO
  TIMELINE
  VINYL
  CASSETTE
  RETRO_PLAYER
  TROPHY_CASE
  COMPACT
  MARQUEE
}

// Public member authentication is isolated from Office administrators and legacy Discord UserDB.
model MemberIdentity {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  email           String    @unique
  displayName     String
  avatarUrl       String?
  passwordHash    String?
  emailVerifiedAt DateTime?
  authVersion     Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("MeGuildMemberIdentity")
}

model MemberOAuthAccount {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  identityId        String   @db.ObjectId
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([identityId])
  @@map("MeGuildMemberOAuthAccount")
}

model MemberAuthChallenge {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  identityId  String    @db.ObjectId
  email       String
  purpose     String
  tokenHash   String
  authVersion Int
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([email, purpose])
  @@index([expiresAt])
  @@map("MeGuildMemberAuthChallenge")
}

model MemberAuthRateLimit {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  bucket    String   @unique
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("MeGuildMemberAuthRateLimit")
}
