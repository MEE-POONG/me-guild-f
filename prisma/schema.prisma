  topic          String
  status         String   @default("CREATING") // CREATING, ACTIVE, CLOSING, CLOSED
  panelMessageId String?
  systemGroup    String? // ADMIN / ENTERTAINMENT; null preserves legacy Busking policy
  roomType       String? // rest / secret / council / public / GAME / LIVE / BEDROOM / TALKSHOW
  categoryId     String?
