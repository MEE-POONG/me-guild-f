// Recruitment is tenant-scoped; Discord identity is global, employment is not.
model StaffApplicationDB {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId             String
  guildName           String
  applicantId         String
  applicantName       String
  sourceChannelId     String
  jobType             String? // Selected community job; null for legacy applications.
  jobName             String? // Display snapshot at submission.
  jobRoleId           String? // Existing Discord role when applicable; not granted by applying.
  interviewResult     String? // PASSED | FAILED; null for pending, legacy or automatic expiry.
  grantedRoleId       String? // Verified Discord role receipt, independent of interview result.
  roleGrantedAt       DateTime?
  reviewedBy          String?
  closedAt            DateTime?
  status              String   @default("PENDING") // PENDING | CALLING | CALLED | CLOSING | CLOSED
  noticeChannelId     String?
  noticeMessageId     String?
  interviewChannelId  String?
  interviewerId       String?
  callToken           String?
  dmStatus            String   @default("NOT_SENT") // NOT_SENT | SENT | FAILED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([guildId, applicantId])
  @@index([guildId, status, createdAt])
}

// Every received Discord command/component; no form contents, options or tokens.
model DiscordInteractionLog {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  interactionId String   @unique
  guildId       String?
  guildName     String?
  channelId     String?
  actorId       String
  botId         String?
  kind          String
  action        String
  status        String // RECEIVED | ACKNOWLEDGED | RESPONDED | ERROR | NO_RESPONSE
  responseMethod String?
  durationMs    Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([guildId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, status, createdAt])
}
